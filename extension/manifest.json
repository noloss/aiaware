{
  "manifest_version": 3,
  "name": "PromptSentinel",
  "version": "0.1.0",
  "description": "Learn to spot AI prompt-injection and security risks in real time.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PromptSentinel"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "storage"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://gemini.google.com/*",
        "*://chat.openai.com/*"
      ],
      "js": ["content.js", "modal.js", "dlp.js"],
      "css": ["modal.css", "dlp.css"],
      "run_at": "document_idle"
    }
  ],

  "host_permissions": []
}
